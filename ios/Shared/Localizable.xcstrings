    "Download the latest Mac host" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuesten Mac-Host laden"
          }
        }
      }
    },
    "Enter the code from the Mac menu “Pair Device…”:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code aus dem Mac-Menü „Gerät koppeln…“ eingeben:"
          }
        }
      }
    },
    "Enter the six-digit code shown on the Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den sechsstelligen Code ein, der am Mac angezeigt wird."
          }
        }
      }
    },
    "Every newly detected code is sent automatically once. If the same code is scanned again, the yellow “Send again” trigger appears." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder neu erkannte Code wird automatisch einmal gesendet. Wird derselbe Code erneut gescannt, erscheint der gelbe Auslöser „Erneut senden“."
          }
        }
      }
    },
    "Forgets all codes already sent, so they can be sent automatically again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergisst alle bereits gesendeten Codes, damit sie wieder automatisch gesendet werden."
          }
        }
      }
    },
    "Found Mac is running an outdated app – please update" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefundener Mac läuft mit veralteter App – bitte aktualisieren"
          }
        }
      }
    },
