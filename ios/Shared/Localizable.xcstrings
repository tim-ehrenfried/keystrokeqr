        }
      }
    },
    "New Mac — pair it once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuer Mac — bitte einmalig koppeln."
          }
        }
      }
    },
    "No camera access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Kamerazugriff"
          }
        }
      }
    },
    "No Mac found yet. Are the iPhone and Mac on the same Wi-Fi, and is the KeystrokeQR Mac app running?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Mac gefunden. Sind iPhone und Mac im selben WLAN, und läuft die KeystrokeQR-Mac-App?"
          }
        }
      }
    },
    "No Mac paired yet. On the Mac, open the “Pair Device…” menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Mac gekoppelt. Öffne auf dem Mac das Menü „Gerät koppeln…“."
          }
        }
      }
    },
    "No response from the Mac. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Antwort vom Mac. Bitte erneut versuchen."
          }
        }
      }
    },
    "On your Mac, open the KeystrokeQR menu and choose “Pair Device…”. It shows a 6-digit code — type it here once when your iPhone finds the Mac. That’s it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne am Mac das KeystrokeQR-Menü und wähle „Gerät koppeln…“. Es erscheint ein 6-stelliger Code — tippe ihn hier einmalig ein, sobald dein iPhone den Mac findet. Fertig."
          }
        }
      }
    },
    "One-time pairing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmaliges Koppeln (Pairing)"
