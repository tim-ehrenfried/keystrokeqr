    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird zum Scannen von QR- und Barcodes benötigt. Der gescannte Inhalt wird an deinen Mac im lokalen Netzwerk gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan QR and barcodes. The scanned content is sent to your Mac on the local network."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sucht deinen Mac im lokalen Netzwerk (Bonjour) und sendet gescannte Codes direkt an ihn. Ohne diese Berechtigung kann kein Mac gefunden werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app finds your Mac on the local network (Bonjour) and sends scanned codes directly to it. Without this permission no Mac can be found."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
