<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: the app only uses standard cryptography from Apple's
	     CryptoKit (HKDF-SHA256, HMAC-SHA256, ChaChaPoly, Curve25519) to secure the
	     local pairing/session (see docs/PROTOCOL-v2.md). This qualifies for the
	     exemption under U.S. export regulations, so no encryption-usage question is
	     asked on every TestFlight/App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>KeystrokeQR</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>de.timehrenfried.keystrokeqr</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>keystrokeqr</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan QR and barcodes. The scanned content is sent to your Mac on the local network.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The app finds your Mac on the local network (Bonjour) and sends scanned codes directly to it. Without this permission no Mac can be found.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_keystrokeqr._tcp</string>
	</array>
</dict>
</plist>
